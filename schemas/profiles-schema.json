{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opquast-skill/schemas/profiles-schema.json",
  "title": "Site Profiles Schema",
  "description": "Schema for site-profiles.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "profiles"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      }
    },
    "detection_priority": {
      "type": "array",
      "description": "Ordre d'essai des profils lors de la détection ; chaque valeur est une clé de profiles",
      "items": {
        "type": "string"
      }
    },
    "fallback_profile": {
      "type": "string",
      "description": "Profil appliqué quand aucun profil n'est détecté (clé de profiles)"
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "detection",
        "regles_critiques",
        "regles_exclues",
        "pages_a_analyser"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "detection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "keywords": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "elements": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "urls": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "meta": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "rubriques_prioritaires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "regles_critiques": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 245,
            "description": "Borne haute liée à la version V5 du référentiel, partagée avec rules-schema.json et audit-report.json"
          },
          "description": "Rule IDs that are critical for this profile"
        },
        "regles_exclues": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 245,
            "description": "Borne haute liée à la version V5 du référentiel, partagée avec rules-schema.json et audit-report.json"
          },
          "description": "Rule IDs not applicable for this profile"
        },
        "pages_a_analyser": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
