# package-lock.json est volontairement versionné : installation reproductible
# (npm ci) et protection contre une version transitive compromise.
# --- Ajouts du 2026-08-07 : eviter la publication accidentelle ---

# Sessions d'authentification enregistrees (Playwright storageState).
# Depot public : ne jamais versionner de cookies ni d'URL de service interne.
.opquast-auth-*.json

# Traces de deliberations, regenerees a chaque session du skill council
deliberations/
scripts/**/deliberations/

# Rapports de couverture produits par les tests
coverage/
scripts/**/coverage/

# Contexte de session local, propre a la machine
.claude/session-context.md
.claude/*.local.md
